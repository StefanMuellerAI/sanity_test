# Lege ein kostenloses Projekt unter https://www.sanity.io/manage an.
# Die folgenden Werte werden sowohl von der Website als auch vom eingebetteten Studio (/studio) genutzt.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Optional: Wird nur fuer authentifizierte Server-Requests benoetigt (z.B. Draft-Vorschau).
SANITY_API_READ_TOKEN=

# Kanonische Domain fuer SEO (sitemap.xml, robots.txt, JSON-LD, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://stefanai.de
